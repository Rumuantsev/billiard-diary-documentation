@startuml
' ER-диаграмма базы данных на русском языке.
' Презентационный вариант: без технических дат и типов.

title ER-диаграмма базы данных

left to right direction

skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 8
skinparam nodesep 55
skinparam ranksep 45
skinparam classAttributeIconSize 0
hide circle

skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
  FontColor #111827
  FontSize 12
  FontStyle plain
  Padding 10
  StereotypeFontSize 0
}

skinparam Arrow {
  Color #475569
  FontColor #334155
  FontSize 10
  Thickness 1
}

entity "Роль пользователя" as role {
  администратор
  тренер
  спортсмен
}

entity "Пользователь" as user {
  email
  хеш пароля
  имя
  роль
  тренер
}

entity "Папка" as folder {
  название
  автор
  родительская папка
  публичная
}

entity "Упражнение" as exercise {
  название
  описание
  позиция шаров
  автор
  папка
  публичное
}

entity "Группа" as group {
  название
  тренер
  описание
}

entity "Спортсмен в группе" as athlete_group {
  спортсмен
  группа
}

entity "Групповая тренировка" as group_training {
  тренер
  группа
  начало
  окончание
  статус
}

entity "Тренировка спортсмена" as athlete_training {
  групповая тренировка
  тренер
  спортсмен
  начало
  окончание
  статус
  статус посещения
}

entity "Элемент тренировки" as training_item {
  тренировка спортсмена
  упражнение
  порядок
  план попыток
  попытки
  успешные попытки
  статус
}


entity "Комментарий" as comment {
  автор
  тренировка спортсмена
  текст
}

' Основной поток чтения диаграммы слева направо.
role -[hidden]right- user
user -[hidden]right- folder
folder -[hidden]right- group
group -[hidden]right- group_training
group_training -[hidden]right- comment

' Локальное выравнивание внутри смысловых блоков.
folder -[hidden]down- exercise
group -[hidden]down- athlete_group
group_training -[hidden]down- athlete_training
athlete_training -[hidden]down- training_item

user --{ user : тренер
role --{ user : роль

user --{ folder : автор
folder --{ folder : родительская
user --{ exercise : автор
folder --{ exercise : папка

user --{ group : тренер
user --{ athlete_group : спортсмен
group --{ athlete_group : группа

user --{ group_training : тренер
group --{ group_training : группа
group_training --{ athlete_training : групповая

user --{ athlete_training : тренер
user --{ athlete_training : спортсмен
athlete_training --{ training_item : тренировка
exercise --{ training_item : упражнение


user --{ comment : автор
athlete_training --{ comment : тренировка

@enduml
