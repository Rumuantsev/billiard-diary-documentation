@startuml
' ER-диаграмма базы данных (PostgreSQL) на русском языке
' Упрощенный вариант: только имена полей, без типов, все связи --{

skinparam linetype ortho
skinparam entity {
  BackgroundColor White
  BorderColor Black
}

entity "пользователь" as пользователь {
  id <<PK>>
  --
  email
  хеш_пароля
  фамилия
  имя
  отчество
  дата_рождения
  роль
  создан
  обновлен
  удален
}

entity "группа" as группа {
  id <<PK>>
  --
  название
  тренер <<FK>>
  описание
  создан
  обновлен
  удален
}

entity "членство_в_группе" as членство {
  спортсмен <<FK>> <<PK>>
  группа <<FK>> <<PK>>
  --
  дата_вступления
}

entity "папка" as папка {
  id <<PK>>
  --
  название
  владелец <<FK>>
  родительская_папка <<FK>>
  создан
  обновлен
}

entity "упражнение" as упражнение {
  id <<PK>>
  --
  название
  описание
  тип_оценки
  требуемое_количество
  порог_успеха
  публичное
  автор <<FK>>
  папка <<FK>>
  создан
  обновлен
  удален
}

entity "позиция" as позиция {
  id <<PK>>
  --
  упражнение <<FK>>
  схема
  сила
  создан
  обновлен
}

entity "тренировка" as тренировка {
  id <<PK>>
  --
  дата
  спортсмен <<FK>>
  тренер <<FK>>
  создан
  обновлен
}

entity "элемент_тренировки" as элемент {
  id <<PK>>
  --
  тренировка <<FK>>
  упражнение <<FK>>
  порядковый_номер
  результат
  максимум
  порог_зачета
  создан
  обновлен
}

entity "комментарий" as комментарий {
  id <<PK>>
  --
  автор <<FK>>
  тренировка <<FK>>
  элемент_тренировки <<FK>>
  текст
  создан
  обновлен
  удален
}

entity "посещаемость" as посещаемость {
  id <<PK>>
  --
  спортсмен <<FK>>
  группа <<FK>>
  дата
  статус
  причина
  создан
}

' Связи (все --{ означает "один ко многим")
пользователь --{ группа 
пользователь --{ членство
группа --{ членство 

пользователь --{ папка 
папка --{ папка 

пользователь --{ упражнение
папка --{ упражнение 

упражнение --{ позиция 

пользователь --{ тренировка 
пользователь --{ тренировка 

тренировка --{ элемент 
упражнение --{ элемент 

пользователь --{ комментарий 
тренировка --{ комментарий
элемент --{ комментарий 

пользователь --{ посещаемость 
группа --{ посещаемость 

' Примечание: для комментария используется полиморфная связь,
' поэтому два внешних ключа с ограничением, что заполнен только один.
@enduml