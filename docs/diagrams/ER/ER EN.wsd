@startuml

skinparam linetype ortho
skinparam entity {
  BackgroundColor White
  BorderColor Black
  FontSize 10
  Padding 10
  StereotypeFontSize 8
}
skinparam classAttributeIconSize 0
skinparam node {
  Padding 20
  BorderColor Black
}

left to right direction

entity "users" as users {
  + id: bigserial <<PK>>
  --
  email: varchar(255) <<unique>>
  password_hash: text
  name: varchar(255)
  role: user_role
  coach_id: bigint <<FK users.id>>
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "folders" as folders {
  + id: bigserial <<PK>>
  --
  title: varchar(255)
  author_id: bigint <<FK users.id>>
  parent_id: bigint <<FK folders.id>>
  is_public: boolean
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "exercise" as exercises {
  + id: bigserial <<PK>>
  --
  title: varchar(255)
  description: text
  position: jsonb
  author_id: bigint <<FK users.id>>
  folder_id: bigint <<FK folders.id>>
  is_public: boolean
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "groups" as groups {
  + id: bigserial <<PK>>
  --
  name: varchar(255)
  coach_id: bigint <<FK users.id>>
  description: text
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "athlete_groups" as athlete_groups {
  + id: bigserial <<PK>>
  --
  athlete_id: bigint <<FK users.id>>
  group_id: bigint <<FK groups.id>>
  created_at: timestamptz
  deleted_at: timestamptz
}

entity "group_training" as group_trainings {
  + id: bigserial <<PK>>
  --
  coach_id: bigint <<FK users.id>>
  group_id: bigint <<FK groups.id>>
  starts_at: timestamptz
  ends_at: timestamptz
  status: varchar(50)
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "athlete_training" as athlete_trainings {
  + id: bigserial <<PK>>
  --
  group_training_id: bigint <<FK group_training.id>>
  coach_id: bigint <<FK users.id>>
  athlete_id: bigint <<FK users.id>>
  starts_at: timestamptz
  ends_at: timestamptz
  status: varchar(50)
  attendance_status: varchar(30)
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "training_item" as training_items {
  + id: bigserial <<PK>>
  --
  athlete_training_id: bigint <<FK athlete_training.id>>
  exercise_id: bigint <<FK exercise.id>>
  order_index: integer
  target_attempts: integer
  result_attempts: integer
  result_successes: integer
  status: varchar(50)
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "athlete_training_comments" as athlete_training_comments {
  + id: bigserial <<PK>>
  --
  athlete_training_id: bigint <<FK athlete_training.id>>
  author_id: bigint <<FK users.id>>
  text: text
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

users |o--o{ users : "coach_id"


users ||--o{ folders : "author_id"
folders |o--o{ folders : "parent_id"
users ||--o{ exercises : "author_id"
folders ||--o{ exercises : "folder_id"

users ||--o{ groups : "coach_id"
users ||--o{ athlete_groups : "athlete_id"
groups ||--o{ athlete_groups : "group_id"

users ||--o{ group_trainings : "coach_id"
groups ||--o{ group_trainings : "group_id"
group_trainings ||--o{ athlete_trainings : "group_training_id"

users ||--o{ athlete_trainings : "coach_id"
users ||--o{ athlete_trainings : "athlete_id"
athlete_trainings ||--o{ training_items : "athlete_training_id"
exercises ||--o{ training_items : "exercise_id"


users ||--o{ athlete_training_comments : "author_id"
athlete_trainings ||--o{ athlete_training_comments : "athlete_training_id"

@enduml
