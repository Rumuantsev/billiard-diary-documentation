@startuml
' ER-диаграмма базы данных (PostgreSQL)

' Настройки внешнего вида
skinparam linetype ortho
skinparam entity {
  BackgroundColor White
  BorderColor Black
  FontSize 10
  Padding 10
  StereotypeFontSize 8
}
skinparam classAttributeIconSize 0
skinparam node {
  Padding 20
  BorderColor Black
}

' Размещение сущностей по сетке
left to right direction

' Сущности
entity "user" as users {
  + id: bigserial <<PK>>
  --
  group_id: bigint <<FK>>
  email: varchar(255) <<unique>>
  password_hash: varchar(255)
  last_name: varchar(100)
  first_name: varchar(100)
  middle_name: varchar(100)
  birth_date: date
  role: user_role
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "group" as groups {
  + id: bigserial <<PK>>
  --
  name: varchar(255)
  coach_id: bigint <<FK>>
  description: text
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "folder" as folders {
  + id: bigserial <<PK>>
  --
  name: varchar(255)
  owner_id: bigint <<FK>>
  parent_folder_id: bigint <<FK>>
  created_at: timestamptz
  updated_at: timestamptz
}

entity "exercise" as exercises {
  + id: bigserial <<PK>>
  --
  name: varchar(255)
  description: text
  is_public: boolean
  power: double precision
  position_layout: jsonb
  author_id: bigint <<FK>>
  folder_id: bigint <<FK>>
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "workout" as workouts {
  + id: bigserial <<PK>>
  --
  date: date
  athlete_id: bigint <<FK>>
  coach_id: bigint <<FK>>
  created_at: timestamptz
  updated_at: timestamptz
}

entity "workout_item" as workout_items {
  + id: bigserial <<PK>>
  --
  workout_id: bigint <<FK>>
  exercise_id: bigint <<FK>>
  order_index: int
  result: int
  max_value: int
  pass_threshold: int
  created_at: timestamptz
  updated_at: timestamptz
}

entity "comment" as comments {
  + id: bigserial <<PK>>
  --
  author_id: bigint <<FK>>
  workout_id: bigint <<FK>>
  workout_item_id: bigint <<FK>>
  text: text
  created_at: timestamptz
  updated_at: timestamptz
  deleted_at: timestamptz
}

entity "attendance" as attendances {
  + id: bigserial <<PK>>
  --
  athlete_id: bigint <<FK>>
  group_id: bigint <<FK>>
  date: date
  status: attendance_status
  reason: text
  created_at: timestamptz
}

' Связи (без указания внешних ключей)
users --> groups

groups --> users

users --> folders

folders --> folders

users --> exercises

folders --> exercises

users --> workouts

users --> workouts

workouts --> workout_items

exercises --> workout_items

users --> comments

workouts --> comments

workout_items --> comments

users --> attendances

groups --> attendances

@enduml