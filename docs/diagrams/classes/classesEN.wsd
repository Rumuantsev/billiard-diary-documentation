@startuml

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor White
  BorderColor Black
}

left to right direction

abstract class User {
  +email
  +passwordHash
  +name
  +authenticate()
  +updateProfile()
}

class Admin {
  +createCoach()
  +viewUsers()
  +editUser()
  +viewExerciseLibrary()
  +editExercise()
}

class Coach {
  +createAthlete()
  +editAthlete()
  +softDeleteAthlete()
  +createGroup()
  +editGroup()
  +addAthleteToGroup()
  +removeAthleteFromGroup()
  +createExercise()
  +editExercise()
  +softDeleteExercise()
  +createFolder()
  +renameFolder()
  +softDeleteFolder()
  +createGroupTraining()
  +editScheduledTraining()
  +changeTrainingStatus()
  +softDeleteTraining()
  +recordAttendance()
  +viewAnalytics()
  +addComment()
}

class Athlete {
  +viewAssignedTrainings()
  +viewTrainingHistory()
  +startTraining()
  +completeTraining()
  +startTrainingItem()
  +completeTrainingItem()
  +skipTrainingItem()
  +recordResult()
  +viewResults()
  +viewCoachComments()
  +addNote()
}

class Group {
  +name
  +description
  +addAthlete()
  +removeAthlete()
  +rename()
}

class Folder {
  +title
  +rename()
  +softDelete()
}

class Exercise {
  +title
  +description
  +position
  +createCopy()
  +updatePosition()
  +updateShotParameters()
  +softDelete()
}

class GroupTraining {
  +startsAt
  +endsAt
  +status
  +schedule()
  +reschedule()
  +cancel()
  +markMissed()
  +start()
  +complete()
  +softDelete()
}

class AthleteTraining {
  +startsAt
  +endsAt
  +status
  +start()
  +complete()
  +addTrainingItem()
  +removeTrainingItem()
}

class TrainingItem {
  +orderIndex
  +targetAttempts
  +resultAttempts
  +resultSuccesses
  +status
  +start()
  +complete()
  +skip()
  +recordResult()
}

class Attendance {
  +attendanceDate
  +status
  +markPresent()
  +markAbsent()
}

class Comment {
  +text
  +create()
  +edit()
  +softDelete()
}

class AnalyticsReport {
  +period
  +groupFilter
  +athleteFilter
  +exerciseFilter
  +calculateAttendance()
  +calculatePerformance()
  +calculateExerciseProgress()
}

User <|-- Admin
User <|-- Coach
User <|-- Athlete

Coach "1" -- "0..*" Athlete : coaches
Coach "1" -- "0..*" Group : owns
Coach "1" -- "0..*" Folder : owns
Coach "1" -- "0..*" Exercise : authors
Coach "1" -- "0..*" GroupTraining : schedules
Coach "1" -- "0..*" Comment : writes

Group "1" -- "0..*" Athlete : contains
Group "1" -- "0..*" GroupTraining : has

Folder "0..1" -- "0..*" Folder : parent folder
Folder "0..1" o-- "0..*" Exercise : contains

Exercise "1" -- "0..*" TrainingItem : assigned as

GroupTraining "1" *-- "1..*" AthleteTraining : consists of
Athlete "1" -- "0..*" AthleteTraining : performs
AthleteTraining "1" *-- "0..*" TrainingItem : contains
AthleteTraining "1" -- "0..1" Attendance : has

TrainingItem "1" -- "0..*" Comment : has
AthleteTraining "1" -- "0..*" Comment : has
GroupTraining "1" -- "0..*" Comment : has
Athlete "1" -- "0..*" Comment : writes notes

AnalyticsReport ..> GroupTraining : uses
AnalyticsReport ..> AthleteTraining : uses
AnalyticsReport ..> TrainingItem : uses
AnalyticsReport ..> Attendance : uses

@enduml
