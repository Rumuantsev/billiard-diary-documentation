@startuml
title Диаграмма 2: Упражнения и библиотека

class Тренер {
}

class Упражнение {
  +id: bigint
  +название: varchar
  +описание: text
  +требуемое_количество: int
  +порог_успеха: int
  +публичное: boolean
  +создан: timestamptz
  +обновлен: timestamptz
  +удален: timestamptz?
}

class Позиция {
  +id: bigint
  +схема: jsonb
  +создан: timestamptz
  +обновлен: timestamptz
}

class Папка {
  +id: bigint
  +название: varchar
  +создан: timestamptz
  +обновлен: timestamptz
}

' Связи упражнений
Тренер "1" -- "0..*" Упражнение : автор
Тренер "1" -- "0..*" Папка : владелец

Упражнение *-- Позиция : состоит из
Папка o-- Упражнение : содержит
Папка --> "родитель" Папка : вложена в

@enduml