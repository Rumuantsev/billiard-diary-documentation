@startuml
title Диаграмма 3: Тренировки и выполнение

class Тренер {
}

class Спортсмен {
}

class Упражнение {
  +id: bigint
  +название: varchar
  +описание: text
  +требуемое_количество: int
  +порог_успеха: int
  +публичное: boolean
  +создан: timestamptz
  +обновлен: timestamptz
  +удален: timestamptz?
}

class Тренировка {
  +id: bigint
  +дата: date
  +создан: timestamptz
  +обновлен: timestamptz
}

class ЭлементТренировки {
  +id: bigint
  +порядковый_номер: int
  +результат: int
  +максимум: int
  +порог_для_зачета: int
}

class Комментарий {
  +id: bigint
  +тип_цели: enum {тренировка, элемент_тренировки}
  +текст: text
  +создан: timestamptz
  +обновлен: timestamptz
  +удален: timestamptz?
}

' Связи тренировок
Тренер "1" -- "0..*" Тренировка : назначает
Спортсмен "1" -- "0..*" Тренировка : выполняет

' Структура тренировки
Тренировка *-- ЭлементТренировки : содержит
Упражнение "1" -- "0..*" ЭлементТренировки : используется в

' Комментарии
Тренер "1" -- "0..*" Комментарий : оставляет
Спортсмен "1" -- "0..*" Комментарий : оставляет
Комментарий --> Тренировка : относится к
Комментарий --> ЭлементТренировки : относится к

@enduml