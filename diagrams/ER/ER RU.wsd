@startuml
' ER-диаграмма базы данных на русском языке.
' Высокоуровневый вариант для заказчика: без технических дат и типов.

skinparam linetype ortho
skinparam entity {
  BackgroundColor White
  BorderColor Black
}

entity "Пользователь" as пользователь {
  email
  хеш пароля
  имя
  роль
  тренер
}

entity "Роль пользователя" as роль {
  администратор
  тренер
  спортсмен
}

entity "Папка" as папка {
  название
  автор
  родительская папка
}

entity "Упражнение" as упражнение {
  название
  описание
  позиция
  автор
  папка
}

entity "Группа" as группа {
  название
  тренер
  описание
}

entity "Спортсмен в группе" as спортсменВГруппе {
  спортсмен
  группа
}

entity "Групповая тренировка" as групповаяТренировка {
  тренер
  группа
  начало
  окончание
  статус
}

entity "Тренировка спортсмена" as тренировкаСпортсмена {
  групповая тренировка
  тренер
  спортсмен
  начало
  окончание
  статус
}

entity "Элемент тренировки" as элементТренировки {
  тренировка спортсмена
  упражнение
  порядок
  план попыток
  попытки
  успешные попытки
  статус
}

entity "Посещаемость" as посещаемость {
  спортсмен
  дата посещения
  статус
}

entity "Комментарий" as комментарий {
  автор
  групповая тренировка
  тренировка спортсмена
  элемент тренировки
  текст
}

пользователь --{ пользователь : тренер
роль --{ пользователь : роль

пользователь --{ папка : автор
папка --{ папка : родительская папка
пользователь --{ упражнение : автор
папка --{ упражнение : папка

пользователь --{ группа : тренер
пользователь --{ спортсменВГруппе : спортсмен
группа --{ спортсменВГруппе : группа

пользователь --{ групповаяТренировка : тренер
группа --{ групповаяТренировка : группа
групповаяТренировка --{ тренировкаСпортсмена : групповая тренировка

пользователь --{ тренировкаСпортсмена : тренер
пользователь --{ тренировкаСпортсмена : спортсмен
тренировкаСпортсмена --{ элементТренировки : тренировка спортсмена
упражнение --{ элементТренировки : упражнение

пользователь --{ посещаемость : спортсмен

пользователь --{ комментарий : автор
групповаяТренировка --{ комментарий : групповая тренировка
тренировкаСпортсмена --{ комментарий : тренировка спортсмена
элементТренировки --{ комментарий : элемент тренировки

@enduml
