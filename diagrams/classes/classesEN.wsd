@startuml

skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor White
  BorderColor Black
}

left to right direction

abstract class User {
  +email
  +passwordHash
  +name
  +authenticate()
  +updateProfile()
}

class Admin {
  +createCoach()
  +viewUsers()
  +editUser()
  +viewExerciseLibrary()
  +createPublicFolder()
  +editPublicFolder()
  +createPublicExercise()
  +editPublicExercise()
}

class Coach {
  +createAthlete()
  +editAthlete()
  +softDeleteAthlete()
  +createGroup()
  +editGroup()
  +addAthleteToGroup()
  +removeAthleteFromGroup()
  +createExercise()
  +editExercise()
  +softDeleteExercise()
  +createFolder()
  +renameFolder()
  +softDeleteFolder()
  +viewPublicLibrary()
  +usePublicExercise()
  +createGroupTraining()
  +editScheduledTraining()
  +changeTrainingStatus()
  +softDeleteTraining()
  +recordAttendance()
  +viewAnalytics()
  +addComment()
  +editComment()
  +softDeleteComment()
}

class Athlete {
  +viewAssignedTrainings()
  +viewTrainingHistory()
  +startTraining()
  +completeTraining()
  +startTrainingItem()
  +completeTrainingItem()
  +skipTrainingItem()
  +recordResult()
  +viewResults()
  +viewCoachComments()
}

class Group {
  +name
  +description
  +addAthlete()
  +removeAthlete()
  +rename()
}

class Folder {
  +title
  +parentId
  +isPublic
  +rename()
  +softDelete()
}

class Exercise {
  +title
  +description
  +position
  +isPublic
  +createCopy()
  +updatePosition()
  +updateShotParameters()
  +softDelete()
}

class GroupTraining {
  +startsAt
  +endsAt
  +status
  +schedule()
  +reschedule()
  +cancel()
  +markMissed()
  +start()
  +complete()
  +softDelete()
}

class AthleteTraining {
  +startsAt
  +endsAt
  +status
  +attendanceStatus
  +start()
  +complete()
  +addTrainingItem()
  +removeTrainingItem()
  +markPresent()
  +markAbsent()
}

class TrainingItem {
  +orderIndex
  +targetAttempts
  +resultAttempts
  +resultSuccesses
  +status
  +start()
  +complete()
  +skip()
  +recordResult()
}


class Comment {
  +text
  +create()
  +edit()
  +softDelete()
}

User <|-- Admin
User <|-- Coach
User <|-- Athlete

Admin "1" --> "0..*" Folder : manages public
Admin "1" --> "0..*" Exercise : manages public

Coach "1" --> "0..*" Athlete : coaches
Coach "1" --> "0..*" Group : owns
Coach "1" --> "0..*" Folder : owns
Coach "1" --> "0..*" Exercise : authors
Coach "1" --> "0..*" GroupTraining : schedules
Coach "1" --> "0..*" Comment : writes

Group "0..*" --> "0..*" Athlete : contains
Group "0..1" --> "0..*" GroupTraining : has

Folder "0..1" --> "0..*" Folder : parent folder
Folder "0..1" o-- "0..*" Exercise : contains

Exercise "1" --> "0..*" TrainingItem : assigned as

GroupTraining "0..1" o-- "0..*" AthleteTraining : consists of
Athlete "1" --> "0..*" AthleteTraining : performs
AthleteTraining "1" *-- "0..*" TrainingItem : contains

AthleteTraining "1" --> "0..*" Comment : has
@enduml
