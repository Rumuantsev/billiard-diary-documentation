@startuml

' Абстрактный класс Пользователь
abstract class Пользователь {
  +id: bigint
  +email: varchar
  +password_hash: varchar
  +фамилия: varchar
  +имя: varchar
  +отчество: varchar
  +дата_рождения: date
  +создан: timestamptz
  +обновлен: timestamptz
  +удален: timestamptz?
}

class Тренер {
}

class Спортсмен {
}

class Группа {
  +id: bigint
  +название: varchar
  +описание: text?
  +создан: timestamptz
  +обновлен: timestamptz
  +удален: timestamptz?
}

class Упражнение {
  +id: bigint
  +название: varchar
  +описание: text
  +требуемое_количество: int
  +порог_успеха: int
  +публичное: boolean
  +создан: timestamptz
  +обновлен: timestamptz
  +удален: timestamptz?
}

class Позиция {
  +id: bigint
  +схема: jsonb
  +сила: int
  +создан: timestamptz
  +обновлен: timestamptz
}

class Папка {
  +id: bigint
  +название: varchar
  +создан: timestamptz
  +обновлен: timestamptz
}

class Тренировка {
  +id: bigint
  +дата: date
  +создан: timestamptz
  +обновлен: timestamptz
}

class ЭлементТренировки {
  +id: bigint
  +порядковый_номер: int
  +результат: int
  +максимум: int
  +порог_для_зачета: int
}

class Комментарий {
  +id: bigint
  +тип_цели: enum {тренировка, элемент_тренировки}
  +текст: text
  +создан: timestamptz
  +обновлен: timestamptz
  +удален: timestamptz?
}

class Посещаемость {
  +id: bigint
  +дата: date
  +статус: enum {присутствовал, отсутствовал, опоздал}
  +причина: text?
  +создан: timestamptz
}

' Наследование
Пользователь <|-- Тренер
Пользователь <|-- Спортсмен

' Композиция: Позиция — часть Упражнения
Упражнение *-- Позиция 

' Композиция: ЭлементТренировки — часть Тренировки
Тренировка *-- ЭлементТренировки 

' Агрегация: Папка содержит упражнения
Папка o-- Упражнение 

' Агрегация: Группа объединяет спортсменов
Группа "1" o-- "0..*" Спортсмен 

' Ассоциации для Тренера
Тренер "1" -- "0..*" Упражнение
Тренер "1" -- "0..*" Тренировка 
Тренер "1" -- "0..*" Группа 
Тренер "1" -- "0..*" Папка 

' Ассоциации для Спортсмена
Спортсмен "1" -- "0..*" Тренировка 
Спортсмен "1" -- "0..*" Посещаемость 

' Ассоциации для Комментария
Тренер "1" -- "0..*" Комментарий 
Спортсмен "1" -- "0..*" Комментарий 

' Ассоциации для ЭлементаТренировки
Упражнение "1" -- "0..*" ЭлементТренировки 

' Полиморфные ассоциации для Комментария
Комментарий --> Тренировка 
Комментарий --> ЭлементТренировки 

' Рекурсивная связь для папок
Папка --> "родитель" Папка 

@enduml